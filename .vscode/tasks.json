      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "env": {
          "RUSTUP_TOOLCHAIN": "esp"
        }
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo",
      "args": ["check"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "env": {
          "RUSTUP_TOOLCHAIN": "esp"
        }
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo run",
